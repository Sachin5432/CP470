<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AndroidAssigments" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.AndroidAssigments" parent="Base.Theme.AndroidAssigments" />

    <!-- NoActionBar theme for activities using a Toolbar widget -->
    <style name="Theme.AndroidAssigments.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Custom Button Style defining height, padding, margins, font size, and font colors -->
    <style name="CustomButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">#3F51B5</item>
    </style>
</resources>